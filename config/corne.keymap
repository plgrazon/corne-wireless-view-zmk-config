#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // 10

#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define MEDIA   3
#define FN      4

&mmv {
    acceleration-exponent = <2>;  // 1 - uniform speed 2 - linear acceleration
    time-to-max-speed-ms = <300>; // 300
    delay-ms = <0>;
    trigger-period-ms = <8>;      // 16
};
&msc {
    acceleration-exponent = <2>;  // 0
    time-to-max-speed-ms = <500>; // 300
    delay-ms = <0>;
    trigger-period-ms = <8>;      // 16
};

/ {
  behaviors {
    hml: homewrow_mods_left {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      label = "HOMEROW_MODS_LEFT_HAND";
      bindings = <&kp>, <&kp>;
      tapping-term-ms = <280>;
      hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
    };
    hmr: homewrow_mods_right {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      label = "HOMEROW_MODS_RIGHT_HAND";
      bindings = <&kp>, <&kp>;
      tapping-term-ms = <280>;
      hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
    };
  };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// ------------------------------------------------------------------------------------------------------
// | ESC  |  Q  |  W      |  E     |  R     |  T  |   |  Y   |  U     |  I     |  O       |  P  | ENT   |
// | TAB  |  A  |  S CTRL |  D ALT |  F CMD |  G  |   |  H   |  J CMD |  K ALT |  L  CTRL |  ;  | '     |
// | SHFT |  Z  |  X      |  C     |  V     |  B  |   |  N   |  M     |  ,     |  .       |  /  | SHIFT |
//                        | GUI    | LWR    | SPC |   | BKSP | RSE    | ALT    |
                        display-name = "Base";
                        bindings = <
   &kp ESC    &kp Q  &kp W         &kp E        &kp R        &kp T        &kp Y     &kp U        &kp I        &kp O         &kp P     &kp RET
   &kp TAB    &kp A  &hml LCTRL S  &hml LALT D  &hml LGUI F  &kp G        &kp H     &hmr RGUI J  &hmr RALT K  &hmr RCTRL L  &kp SEMI  &kp SQT
   &kp LSHFT  &kp Z  &kp X         &kp C        &kp V        &kp B        &kp N     &kp M        &kp COMMA    &kp DOT       &kp FSLH  &kp RSHFT
                                   &kp LGUI     &to LOWER    &kp SPACE    &kp BSPC  &to RAISE    &kp RALT
                        >;
                };

                lower_layer {
// ---------------------------------------------------------------------------------------
// | ESC   |  1  | 2 CTRL | 3 ALT | 4 CMD  |  5   |   |  6    |  7 CMD  |  8 ALT  |  9 CTRL  |  0  | ENT  |
// | TAB   | SCL | MC1    | MUP   | MC2    | SCUP |   | LEFT  |  DOWN   |  UP     |  RIGHT   |     |      |
// | SHFT  | SCR | MLT    | MDN   | MRT    | SCDN |   | BTCLR |  BT1    |  BT2    |  BT3     | BT4 | BT5  |
//                        | GUI   | MEDIA  | SPC  |   | BKSP  | BASE    |  ALT    |
                        display-name = "Lower";
                        bindings = <
   &kp ESC    &kp N1          &hml LCTRL N2   &hml LALT N3    &hml LGUI N4     &kp N5          &kp N6      &hml RGUI N7  &hml RALT N8  &hml RCTRL N9  &kp N0        &kp RET
   &kp TAB    &msc MOVE_LEFT  &mkp MB1        &mmv MOVE_UP    &mkp MB2         &msc MOVE_UP    &kp LEFT    &kp DOWN      &kp UP        &kp RIGHT      &trans        &trans
   &kp LSHFT  &msc MOVE_RIGHT &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc MOVE_DOWN  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4
                                              &kp LGUI        &to MEDIA        &kp SPACE       &kp BSPC    &to DEFAULT   &kp RALT
                        >;
                };

                raise_layer {
// --------------------------------------------------------------------------------
// | ESC  |  !  |  @ CTRL |  # ALT  |  $ CMD  |  %  |   |  ^   |  & CMD |  * ALT |  ( CTRL |  )  | ENT  |
// | CTRL |     |         |         |         |     |   |  -   |  =     |  [     |  ]      |  \  |  `   |
// | SHFT |     |         |         |         |     |   |  _   |  +     |  {     |  }      | "|" |  ~   |
//                        |  GUI    | BASE    | SPC |   | BKSP | FN     |  ALT   |
                        display-name = "Raise";
                        bindings = <
   &kp ESC    &kp EXCL  &hml LCTRL AT  &hml LALT HASH  &hml LGUI DLLR  &kp PRCNT    &kp CARET  &hml RGUI AMPS  &hml RALT KP_MULTIPLY  &hml RCTRL LPAR  &kp RPAR  &kp RET
   &kp LCTRL  &trans    &trans         &trans          &trans          &trans       &kp MINUS  &kp EQUAL       &kp LBKT               &kp RBKT         &kp BSLH  &kp GRAVE
   &kp LSHFT  &trans    &trans         &trans          &trans          &trans       &kp UNDER  &kp PLUS        &kp LBRC               &kp RBRC         &kp PIPE  &kp TILDE
                                       &kp LGUI        &to DEFAULT     &kp SPACE    &kp BSPC   &to FN          &kp RALT
                        >;
                };

                media_layer {
// ---------------------------------------------------------------------------------------
// | ESC   |     | PREV   | PLAY  | NEXT   |      |   |       | BRIDN   | BRIUP   |          |     | ENT  |
// | TAB   |     | MUTE   | VOLDN | VOLUP  |      |   |       |         |         |          |     |      |
// | SHFT  |     |        |       |        |      |   |       |         |         |          |     |      |
//                        | GUI   | BASE   | SPC  |   | BKSP  | BASE    | ALT     |
                        display-name = "Media";
                        bindings = <
   &kp ESC    &trans  &kp C_PREV  &kp C_PP      &kp C_NEXT    &trans    &trans  &kp C_BRI_DN  &kp C_BRI_UP  &trans  &trans  &kp RET
   &kp TAB    &trans  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &trans    &trans  &trans        &trans        &trans  &trans  &trans
   &kp LSHFT  &trans  &trans      &trans        &trans        &trans    &trans  &trans        &trans        &trans  &trans  &kp RSHFT
                                  &kp LGUI      &to DEFAULT   &kp SPACE &kp BSPC &to DEFAULT  &kp RALT
                        >;
                };

                fn_layer {
// ---------------------------------------------------------------------------------------
// | ESC   | F1  | F2     | F3    | F4     | F5   |   | F6    | F7      | F8      | F9       | F10 | ENT  |
// | TAB   | F11 | F12    |       |        |      |   |       |         |         |          |     |      |
// | SHFT  |     |        |       |        |      |   |       |         |         |          |     |      |
//                        | GUI   | BASE   | SPC  |   | BKSP  | BASE    | ALT     |
                        display-name = "FN";
                        bindings = <
   &kp ESC    &kp F1  &kp F2      &kp F3        &kp F4        &kp F5    &kp F6  &kp F7        &kp F8        &kp F9  &kp F10 &kp RET
   &kp TAB    &kp F11 &kp F12     &trans        &trans        &trans    &trans  &trans        &trans        &trans  &trans  &trans
   &kp LSHFT  &trans  &trans      &trans        &trans        &trans    &trans  &trans        &trans        &trans  &trans  &kp RSHFT
                                  &kp LGUI      &to DEFAULT   &kp SPACE &kp BSPC &to DEFAULT  &kp RALT
                        >;
                };
        };
};

